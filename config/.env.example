# ====================================================================
# NABIL AI ASSISTANT: MASTER ENVIRONMENT CONFIGURATION
# Tagline: One Assistant. All Conversations. Zero Manual Replies.
# ====================================================================

# --- General System Settings ---
NODE_ENV=production
APP_PORT=3000
BACKEND_PORT=4000
N8N_PORT=5678
SYSTEM_TIMEZONE=Asia/Dhaka
PUBLIC_WEBHOOK_URL=https://your-domain.ngrok-free.app

# --- n8n Core Security & Settings ---
N8N_HOST=0.0.0.0
N8N_ENCRYPTION_KEY=generate_a_random_32_character_key_here_for_n8n
WEBHOOK_URL=https://your-domain.ngrok-free.app/
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION=1.76.0

# --- Supabase Database (PostgreSQL) ---
# Obtain from your Supabase Project Settings -> Database
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your_supabase_service_role_key
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xyzcompany.supabase.co:5432/postgres

# --- AI Engines ---
# Primary: OpenAI (GPT-4o, Whisper, TTS, Embeddings)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_DEFAULT_MODEL=gpt-4o

# Alternative: Google Gemini API (Gemini 2.0 Flash / Gemini 1.5 Pro)
GEMINI_API_KEY=AIzaSy...your_gemini_api_key_here
GEMINI_DEFAULT_MODEL=gemini-2.0-flash

# Default AI Provider (openai or gemini)
DEFAULT_AI_PROVIDER=openai

# --- Gmail Integration ---
# Google Cloud Console -> APIs & Services -> Credentials (OAuth 2.0 Client ID)
GMAIL_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_google_client_secret
GMAIL_REFRESH_TOKEN=your_google_oauth_refresh_token
GMAIL_USER_EMAIL=nabil.assistant.hq@gmail.com

# --- WhatsApp Business Cloud API (Official Meta) ---
# Meta for Developers -> WhatsApp -> API Setup
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
WHATSAPP_PHONE_NUMBER_ID=109283746501928
WHATSAPP_BUSINESS_ACCOUNT_ID=987654321098765
WHATSAPP_ACCESS_TOKEN=EAAB...permanent_system_user_access_token_here
WHATSAPP_VERIFY_TOKEN=nabil_assistant_secure_meta_verify_token_2026

# --- Automation Modes & Safeguards ---
# manual_approval | semi_automatic | full_automation
DEFAULT_AUTOMATION_MODE=manual_approval
AUTO_REPLY_DELAY_SECONDS=30
MAX_RESPONSE_TOKENS=600
BANGLA_SUPPORT_ENABLED=true
